{
  // Strict structured-output contract for the image_analyser agent.
  // Every key is required by the API; use null when the image does not allow
  // the value to be deduced with confidence.
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "description": "One short sentence describing what the image is."
    },
    "event_type": {
      "type": ["string", "null"],
      "enum": [
        "expense",
        "income",
        "debt_payment",
        "subscription",
        "refund",
        "investment_purchase",
        "investment_sale",
        "investment_valuation"
      ],
      "description": "Kind of financial event evidenced by the image."
    },
    "category": {
      "type": ["string", "null"],
      "enum": [
        "cloud_storage",
        "debt_repayment",
        "delivery_membership",
        "dining",
        "education",
        "entertainment",
        "family_support",
        "groceries",
        "gym",
        "healthcare",
        "housing",
        "insurance",
        "investment",
        "music_subscription",
        "rent",
        "salary",
        "shopping",
        "streaming",
        "transport",
        "utilities",
        "windfall",
        "work_expense"
      ],
      "description": "Spending or income category of the event."
    },
    "direction": {
      "type": ["string", "null"],
      "enum": ["credit", "debit", "non_cash"],
      "description": "Cash-flow direction of the event."
    },
    "amount": {
      "type": ["number", "null"],
      "description": "Transaction amount as a plain number."
    },
    "currency": {
      "type": ["string", "null"],
      "enum": ["INR", "ZAR", "IDR", "USD", "EUR"],
      "description": "Currency code of the amount."
    },
    "event_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Date the event occurred (YYYY-MM-DD)."
    },
    "settlement_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Distinct settlement or clearing date, if shown (YYYY-MM-DD)."
    },
    "status": {
      "type": ["string", "null"],
      "enum": [
        "settled",
        "pending",
        "scheduled",
        "failed",
        "cancelled",
        "unrealized"
      ],
      "description": "Settlement status evidenced by the image."
    }
  },
  "required": [
    "summary",
    "event_type",
    "category",
    "direction",
    "amount",
    "currency",
    "event_date",
    "settlement_date",
    "status"
  ]
}
