{
  // Strict structured-output contract for the image_analyser agent.
  // An image is only ever the source of a financial event's missing amount;
  // every other field is already populated in the events table, so the model
  // returns just the amount and a short summary.
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "description": "One short sentence describing what the image is."
    },
    "amount": {
      "type": ["number", "null"],
      "description": "Final settled/payable transaction amount as a plain number, or null when no amount is shown."
    },
    "direction": {
      "type": ["string", "null"],
      "description": "Whether the image evidences money leaving the account (debit) or arriving (credit); null if unclear."
    }
  },
  "required": ["summary", "amount", "direction"]
}
